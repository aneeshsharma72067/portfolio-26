# Google Analytics 4 — Measurement ID from your Web Data Stream.
# Find it in GA4: Admin → Data Streams → (your stream) → "Measurement ID".
# Copy this file to `.env` and paste your real ID. `.env` is gitignored.
# Vite only exposes vars prefixed with VITE_ to client code.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
